<h1>Add a House Plant</h1>

<%= form_with model: @house_plant, local: true do |f| %>

  <%= f.label :plant_type, "Plant Type" %>
  <%= f.text_field :plant_type %>

  <%= f.label :height %>
  <%= f.number_field :height %>

  <%= f.label :room_id, "Room" %>
  <%= f.collection_select :room_id, @rooms, :id, :name, prompt: "Select a room" %>

  <%= f.submit "Create House Plant" %>

<% end %>