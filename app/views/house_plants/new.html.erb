<h1>New House Plant</h1>

<%= form_with model: @house_plant, local: true do |f| %>
  <%= f.label :plant_type %>
  <%= f.text_field :plant_type %>
  <br />
  <br />

  <%= f.label :height %>
  <%= f.number_field :height %>
  <br />
  <br />

  <%= f.label :room_id %>
  <%= f.collection_select :room_id, @rooms, :id, :name %>
  <br />
  <br />

  <%= f.submit %>
<% end %>
