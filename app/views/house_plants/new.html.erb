<h1>New House Plant</h1>

<% if @house_plant.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@house_plant.errors.count, "error") %> prohibited this house plant from being saved:</h2>
    <ul>
      <% @house_plant.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @house_plant, local: true do |f| %>
  <%= f.label :plant_type %>
  <%= f.text_field :plant_type %>
  <br />
  <br />

  <%= f.label :height %>
  <%= f.number_field :height %>
  <br />
  <br />

  <%= f.label :room_id %>
  <%= f.collection_select :room_id, @rooms, :id, :name, include_blank: "Select a room..." %>
  <br />
  <br />

  <%= f.submit %>
<% end %>
