<h1>New House Plant</h1>

<%= form_with model: @house_plant, local: true do |form| %>
  <%= form.label :plant_type  %>
  <%= form.text_field :plant_type %>
  
  <%= form.label :height  %>
  <%= form.number_field :height %>

  <%= form.label :room  %>
  <%= form.collection_select :room_id, @rooms, :id, :name%>
  
  <%= form.submit "Create House Plant " %>
<% end %>
